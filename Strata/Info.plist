<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Open .strata packages in place (iCloud Drive, Files, SMB share) rather
	     than copying them into the iOS app container. The Case Library is a
	     user-chosen folder accessed via security-scoped bookmarks; evidence
	     must never be silently duplicated. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- A .strata case is a directory bundle; declare it as a package document
	     type so Finder / Files / iCloud Drive treat each case as one item and
	     both apps can open it directly. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.bonnicilabs.strata-case</string>
			<key>UTTypeDescription</key>
			<string>Strata Case</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>strata</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Strata Case</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.bonnicilabs.strata-case</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
